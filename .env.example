# === PostgreSQL ===
POSTGRES_USER=mama
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=mama
DATABASE_URL=postgresql://mama:changeme_in_prod@db:5432/mama

# === Redis / очередь ===
REDIS_URL=redis://redis:6379

# === API ===
API_PORT=8080
JWT_SECRET=replace_with_long_random_secret

# === Worker ===
SCHEDULER_CRON=0 6 * * *        # ежедневно в 06:00

# === Push (FCM) ===
FCM_SERVER_KEY=your_fcm_key
